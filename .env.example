# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or paste a real key into frontend code or chat.
#
# On Vercel, do not upload this file. Add these values in
# Project Settings -> Environment Variables instead.
# Never use NEXT_PUBLIC_* or VITE_* prefixes for secrets: those are exposed to
# the browser. The frontend never receives an API key in this project.

# Required: create a key at https://openrouter.ai/keys
# Keep the value on your machine and in Vercel's server-side env vars only.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-own-key

# The project currently talks to OpenRouter only. If you add a direct Google
# Gemini integration later, put GEMINI_API_KEY here and read it only in
# server-side code. It is not used by the current implementation.

# Optional: port for the local server (ignored on Vercel)
PORT=3000

# Optional: bind address. 127.0.0.1 keeps the server private to this computer.
# Use 0.0.0.0 only if you intentionally want other devices on your network to connect.
HOST=127.0.0.1

# Optional: public URL used for OpenRouter's HTTP-Referer header.
# On Vercel it is detected from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_URL=http://localhost:3000
